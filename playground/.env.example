# Required before anonymous scans are enabled; never expose these to client components.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: pinned published version of our canonical CLI. Do not set to a mutable 'latest'.
SHIP_CHECK_PLAYGROUND_SCANNER_VERSION=0.0.0-alpha.9
# Vercel Sandbox uses the deployment's OIDC identity automatically on Vercel.
